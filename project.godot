; Engine configuration file.
; Scales of Anubis

config_version=5

[application]

config/name="Scales of Anubis"
config/version="0.1.0-demo"
run/main_scene="res://scenes/ui/Main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Textos="*res://scripts/autoload/textos.gd"
Dialogos="*res://scripts/autoload/dialogos.gd"
SFX="*res://scripts/autoload/sfx.gd"
GameTime="*res://scripts/autoload/game_time.gd"
GameState="*res://scripts/autoload/game_state.gd"
Codex="*res://scripts/autoload/codex.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

